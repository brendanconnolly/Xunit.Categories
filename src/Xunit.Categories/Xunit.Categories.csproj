<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Friendly Traits for xUnit.net 2.x</Description>
    <Version>4.0.0</Version>
    <FileVersion>4.0.0</FileVersion>
    <PackageId>xunit.categories</PackageId>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageVersion>4.0.0</PackageVersion>
    <PackageReleaseNotes>
      - Refactor to an Incremental Roslyn Source Generator
    </PackageReleaseNotes>
    <PackageTags>Xunit xunit test category categories trait</PackageTags>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>enable</Nullable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.core" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xunit.Categories.SourceGenerators\Xunit.Categories.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Xunit.Categories.txt" />
  </ItemGroup>

</Project>
