<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Friendly Traits for xUnit.net 3.x</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0</FileVersion>
    <PackageId>xunit.categories.v3</PackageId>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageVersion>1.0.0</PackageVersion>
    <PackageReleaseNotes>
      - Initial version for xUnit v3
    </PackageReleaseNotes>
    <PackageTags>Xunit xunit test category categories trait</PackageTags>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  
  <PropertyGroup>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" Version="3.0.0" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Xunit.Categories.V3.SourceGenerators\Xunit.Categories.V3.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\Xunit.Categories\Xunit.Categories.txt" Link="Xunit.Categories.txt" />
  </ItemGroup>

</Project>
